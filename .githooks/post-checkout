#!/usr/bin/env bash
# post-checkout: re-instantiate packages when switching branches if Manifest differs.
# Args: $1=prev HEAD, $2=new HEAD, $3=1 for branch checkout / 0 for file checkout

PREV_HEAD=$1
NEW_HEAD=$2
BRANCH_CHECKOUT=$3

# Only act on branch switches, not individual file checkouts.
[ "$BRANCH_CHECKOUT" = "1" ] || exit 0

git diff "$PREV_HEAD" "$NEW_HEAD" --name-only 2>/dev/null | grep -q "Manifest.toml" || exit 0

echo ""
echo "  Manifest.toml differs from previous branch - running Pkg.instantiate..."
julia --project -e 'import Pkg; Pkg.instantiate()' 2>&1
echo ""
